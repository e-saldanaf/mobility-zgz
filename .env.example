# Variables de entorno de ejemplo (NO COMMITTEAR credenciales reales)
# Cadena de conexión PostgreSQL (compatible con Supabase)
DATABASE_URL="postgresql://user:password@host:5432/database"

# Opcional - si se integra con Supabase directamente
# SUPABASE_URL="https://xxxx.supabase.co"
# SUPABASE_KEY="public-anon-or-service-role-key"

# API externa (Zaragoza Open Data)
BIZI_API_URL="https://www.zaragoza.es/some/endpoint?rf=json"

# Logging / entorno
ENVIRONMENT=development
LOG_LEVEL=INFO
